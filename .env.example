# Salin ke .env.local untuk pengembangan lokal, dan isikan juga di
# Vercel > Settings > Environment Variables untuk SEMUA environment
# (Production, Preview, Development).

# Supabase. Wajib. Tanpa keduanya seluruh pengambilan data gagal.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini, dipakai endpoint /api/kurasi saja. Tanpa ini endpoint tersebut
# membalas 500 dengan pesan yang jelas; bagian aplikasi lain tetap jalan.
GEMINI_API_KEY=

# Opsional. Default: gemini-3.5-flash
GEMINI_MODEL=
