# Salin ke .env.local untuk pengembangan lokal, dan isikan juga di
# Vercel > Settings > Environment Variables untuk SEMUA environment
# (Production, Preview, Development).

# Supabase. Wajib. Tanpa keduanya seluruh pengambilan data gagal.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini, dipakai endpoint /api/kurasi saja. Tanpa ini endpoint tersebut
# membalas 500 dengan pesan yang jelas; bagian aplikasi lain tetap jalan.
GEMINI_API_KEY=

# Opsional. Default: gemini-3.5-flash
GEMINI_MODEL=

# Opsional, HANYA untuk `npm run update-data` / `npm run sync-data` di komputer
# lokal — tidak dipakai aplikasi, jangan diisi di Vercel. Folder tarikan INAPROC
# di komputer ini (yang berisi subfolder rup/, tender/, ekatalog/).
# Default kalau dikosongkan: D:\INAPROC-Data\sync-state\v1
INAPROC_SYNC_DIR=

# Wajib HANYA untuk `npm run update-data-live` (scripts/pull_from_inaproc.mjs) --
# tidak dipakai aplikasi, jangan diisi di Vercel. Token Bearer LKPP/INAPROC, sama
# seperti dipakai web-app untuk menarik data.inaproc.id. Tanpa ini script berhenti
# sebelum melakukan permintaan apa pun.
JWT_TOKEN=

# Opsional, HANYA untuk scripts/pull_from_inaproc.mjs. Kode KLPD (instansi) yang
# dikirim sebagai ?kode_klpd= ke setiap permintaan. Default: K34.
INAPROC_KODE_KLPD=

# Opsional, HANYA untuk scripts/pull_from_inaproc.mjs. Base URL API INAPROC.
# Default: https://data.inaproc.id/api
INAPROC_API_BASE_URL=

# Opsional, HANYA untuk scripts/update_from_data_update.mjs -- tidak dipakai
# aplikasi, jangan diisi di Vercel. Base URL aplikasi yang dipanggil untuk
# hitung ulang risiko pengadaan otomatis setelah update data selesai (lihat
# docs/RUNBOOK-UPDATE-DATA.md §5b). Default kalau dikosongkan:
# https://god-pbj.vercel.app -- isi dengan http://localhost:3000 kalau ingin
# menguji lokal (dev server harus sedang jalan). Lewati langkah ini dengan
# flag --skip-risiko kalau tidak ingin menunggu.
RISIKO_RECALC_BASE_URL=
